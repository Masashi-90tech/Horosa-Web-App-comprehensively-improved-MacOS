[
	{
		"_comment": "re は空白を除いた原文に対して照合する。to の $1 はグループをそのまま、{1} はグループを辞書で訳したものに置き換える。"
	},
	{
		"re": "^(\\d+)条/页$",
		"to": "$1 件/ページ"
	},
	{
		"re": "^共(\\d+)条$",
		"to": "全 $1 件"
	},
	{
		"re": "^第(\\d+)宫$",
		"to": "第$1ハウス"
	},
	{
		"re": "^正在准备本地服务\\((\\d+)s\\)…$",
		"to": "ローカルサービスを準備中（$1秒）…"
	},
	{
		"re": "^(.+)·操作手册$",
		"to": "{1} · 操作マニュアル"
	}
]
