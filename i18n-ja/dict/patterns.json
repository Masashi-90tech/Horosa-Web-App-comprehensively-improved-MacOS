[
	{
		"_comment": "re は空白を除いた原文に対して照合する。to の $1 はグループをそのまま、{1} はグループを辞書で訳したものに置き換える。"
	},
	{
		"re": "^(\\d+)条/页$",
		"to": "$1 件/ページ"
	},
	{
		"re": "^共(\\d+)条$",
		"to": "全 $1 件"
	},
	{
		"re": "^第(\\d+)宫$",
		"to": "第$1ハウス"
	},
	{
		"re": "^正在准备本地服务\\((\\d+)s\\)…$",
		"to": "ローカルサービスを準備中（$1秒）…"
	},
	{
		"re": "^(.+)·操作手册$",
		"to": "{1} · 操作マニュアル"
	},
	{
		"re": "^(\\d+)岁$",
		"to": "$1歳"
	},
	{
		"re": "^(\\d+)-(\\d+)岁$",
		"to": "$1〜$2歳"
	},
	{
		"re": "^·([\\d.]+)岁-([\\d.]+)岁$",
		"to": "· $1〜$2歳"
	},
	{
		"re": "^直接时间:(\\d{4}-\\d\\d-\\d\\d)(\\d\\d:\\d\\d:\\d\\d)$",
		"to": "入力した時刻：$1 $2"
	},
	{
		"re": "^真太阳时:(\\d{4}-\\d\\d-\\d\\d)(\\d\\d:\\d\\d:\\d\\d)$",
		"to": "真太陽時：$1 $2"
	},
	{
		"re": "^出生后(\\d+)年(\\d+)个月(\\d+)天(\\d+)小时起运$",
		"to": "出生後 $1年$2か月$3日$4時間で運が始まる"
	},
	{
		"re": "^隐藏(.)\\(连带不参与相位连线\\)$",
		"to": "$1を非表示（アスペクト線にも含めない）"
	},
	{
		"re": "^([+-]\\d+)时$",
		"to": "$1時間"
	},
	{
		"re": "^基础神煞·已选(\\d+)$",
		"to": "基本の神殺 · $1 件選択"
	},
	{
		"re": "^(.+)（气）$",
		"to": "{1}（気）"
	},
	{
		"re": "^(.+)（水）$",
		"to": "{1}（水）"
	},
	{
		"re": "^自定(命|身)宫·(.)$",
		"to": "$1宮を指定·$2"
	},
	{
		"re": "^([^-]{2,4})-(.{1,2}宫.)$",
		"to": "{1}-{2}"
	}
]
